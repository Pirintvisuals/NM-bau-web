# nmbau.hu — kanonikus domain: mindig www + https
# A www nélküli (nmbau.hu) és http kérések 301-gyel a www-re mennek,
# így a megosztott linkek (Facebook/Messenger stb.) egyetlen címen,
# egyetlen előnézettel jelennek meg.
RewriteEngine On

# nmbau.hu  ->  https://www.nmbau.hu  (host-alapú, nincs hurok)
RewriteCond %{HTTP_HOST} ^nmbau\.hu$ [NC]
RewriteRule ^(.*)$ https://www.nmbau.hu/$1 [R=301,L]

# Nyelvi útvonal-előtagok (kliensoldali i18n).
# A magyar a gyökéren él (nincs előtag); az angol a /en/…, a német a /de/… alatt.
# Mindkét előtag UGYANAZT a fájlt szolgálja ki, mint a gyökér — a fordítást az
# assets/i18n.js végzi a böngészőben. Az előtagot belsőleg lecsupaszítjuk, hogy a
# relatív hivatkozások (assets/…, *.html) /en/ és /de/ alatt is helyesen oldódjanak
# fel, és a megosztott/frissített linkek ne 404-eljenek.
RewriteRule ^(en|de)/?$ index.html [L]
RewriteRule ^(en|de)/(.+)$ $2 [L]

# A referenciák galériát a tulajdonos a /blog/admin felületről tölti fel.
# A /referenciak.html címet belsőleg a referenciak.php szolgálja ki, amely a
# feltöltött képeket rendereli. A cím és a belső linkek változatlanok maradnak.
# CSAK akkor irányítunk a PHP-ra, ha az tényleg fent van — különben a statikus
# referenciak.html szolgál ki (nincs 404, ha a PHP fájl nincs feltöltve).
RewriteCond %{DOCUMENT_ROOT}/referenciak.php -f
RewriteRule ^referenciak\.html$ referenciak.php [L]
